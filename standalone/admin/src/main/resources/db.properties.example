# Template. For local dev, copy this to db.properties in the same directory (it is
# .gitignored and excluded from the packaged WAR). For any deployed environment,
# supply these as environment variables / -D system properties instead - do not
# create db.properties on a server.
#
# Resolution order (db/DBUtil via util/Config): -Djdbc.url  ->  $JDBC_URL  ->  db.properties
#
#   jdbc.url              / JDBC_URL              (required)
#   jdbc.user             / JDBC_USER             (required)
#   jdbc.password         / JDBC_PASSWORD         (required)
#   jdbc.pool.maxSize     / JDBC_POOL_MAX_SIZE    (default 10)
#   jdbc.pool.minIdle     / JDBC_POOL_MIN_IDLE    (default 2)
#   upload.dir            / UPLOAD_DIR            (default: <user.home>/c3s-admin-uploads)
#   session.cookie.secure / SESSION_COOKIE_SECURE (default false; set true behind HTTPS)
#   log.dir               / LOG_DIR              (default: <catalina.base>/logs)

jdbc.url=jdbc:mysql://db-host:3306/admin?sslMode=REQUIRED&serverTimezone=UTC&characterEncoding=UTF-8
jdbc.user=admin_app
jdbc.password=CHANGE_ME
jdbc.pool.maxSize=10
jdbc.pool.minIdle=2
upload.dir=/var/lib/c3s-admin/uploads
session.cookie.secure=true
